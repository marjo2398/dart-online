Options -Indexes

<FilesMatch "(^config[^/]*\.php(?:\..*)?$|^device-secret\.bin$|\.sqlite(?:-wal|-shm)?(?:\..*)?$|\.(?:sql|log|bak|backup|zip|gz|tgz)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule !mod_authz_core.c>
  <FilesMatch "(^config[^/]*\.php(?:\..*)?$|^device-secret\.bin$|\.sqlite(?:-wal|-shm)?(?:\..*)?$|\.(?:sql|log|bak|backup|zip|gz|tgz)$)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
